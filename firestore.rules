rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'goldenhandcaregivers@gmail.com';
    }

    function createsWithoutAdminPricing() {
      return !request.resource.data.keys().hasAny([
        'dailyRate', 'pricingUnit', 'pricingUpdatedAt', 'pricingUpdatedBy'
      ]);
    }

    function preservesAdminPricing() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'dailyRate', 'pricingUnit', 'pricingUpdatedAt', 'pricingUpdatedBy'
      ]);
    }

    function validWebsiteLeadBase() {
      return request.resource.data.keys().hasOnly([
          'type', 'name', 'phone', 'whatsapp', 'service', 'durationDays',
          'startDate', 'startTime', 'address', 'status', 'timestamp',
          'position', 'experience', 'nvq', 'slmc', 'message'
        ])
        && request.resource.data.keys().hasAll(['type', 'name', 'status', 'timestamp'])
        && request.resource.data.type in ['LOCAL_CLIENT', 'TOURIST', 'STAFF_APPLICATION']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.status == 'NEW'
        && request.resource.data.timestamp is int
        && request.resource.data.timestamp > 0;
    }

    function validLocalWebsiteLead() {
      return request.resource.data.type == 'LOCAL_CLIENT'
        && request.resource.data.keys().hasAll([
          'phone', 'service', 'durationDays', 'startDate', 'startTime', 'address'
        ])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 1
        && request.resource.data['service'].size() <= 120
        && request.resource.data.durationDays is string
        && request.resource.data.durationDays.size() >= 1
        && request.resource.data.durationDays.size() <= 4
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() >= 1
        && request.resource.data.startDate.size() <= 20
        && request.resource.data.startTime is string
        && request.resource.data.startTime.size() >= 1
        && request.resource.data.startTime.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 1
        && request.resource.data.address.size() <= 500;
    }

    function validTouristWebsiteLead() {
      return request.resource.data.type == 'TOURIST'
        && request.resource.data.keys().hasAll([
          'whatsapp', 'service', 'durationDays', 'address'
        ])
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 7
        && request.resource.data.whatsapp.size() <= 30
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 1
        && request.resource.data['service'].size() <= 120
        && request.resource.data.durationDays is string
        && request.resource.data.durationDays.size() >= 1
        && request.resource.data.durationDays.size() <= 4
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 1
        && request.resource.data.address.size() <= 500;
    }

    function validStaffWebsiteLead() {
      return request.resource.data.type == 'STAFF_APPLICATION'
        && request.resource.data.keys().hasAll([
          'phone', 'position', 'experience', 'nvq', 'slmc', 'message'
        ])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.position is string
        && request.resource.data.position.size() >= 1
        && request.resource.data.position.size() <= 100
        && request.resource.data.experience is string
        && request.resource.data.experience.size() <= 100
        && request.resource.data.nvq is string
        && request.resource.data.nvq.size() <= 100
        && request.resource.data.slmc is string
        && request.resource.data.slmc.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000;
    }

    // Spark-plan administration is restricted to the designated verified
    // account. The local Electron Admin SDK process bypasses client rules.
    match /{adminDocument=**} {
      allow read, write: if isAdmin();
    }

    match /settings/website_content {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /website_leads/{leadId} {
      allow create: if validWebsiteLeadBase()
        && (validLocalWebsiteLead()
          || validTouristWebsiteLead()
          || validStaffWebsiteLead());
      allow read, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && createsWithoutAdminPricing());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && preservesAdminPricing());
      allow delete: if isAdmin();

      match /{nestedDocument=**} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    // Public discovery records contain only the limited fields copied by the
    // backend. Signed-in users may browse them; owners may maintain their own
    // profile while the migration to server-only writes is completed.
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && createsWithoutAdminPricing());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && preservesAdminPricing());
      allow delete: if isAdmin();
    }

    match /public_jobs/{jobId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /live_locations/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Transitional compatibility rule: the current Android/Flutter clients
    // still perform booking, chat, wallet and care-log writes directly. This
    // closes anonymous public access immediately without breaking those live
    // flows. These collections should move to callable functions before this
    // fallback is replaced with strict per-document ownership rules.
    match /{collection}/{document} {
      allow read, write: if signedIn()
        && collection != 'users'
        && collection != 'public_profiles'
        && collection != 'public_jobs'
        && collection != 'live_locations';
    }
  }
}
